<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(SharpTfm)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="7.0.1" />
    <!-- the C# compiler the in-game code editor uses to turn Scripts/*.cs into components -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" Condition="'$(UseSdkRoslyn)' != 'true'" />
  </ItemGroup>

  <!-- offline builds: -p:UseSdkRoslyn=true uses the compiler that ships inside the .NET SDK instead of the NuGet package -->
  <ItemGroup Condition="'$(UseSdkRoslyn)' == 'true'">
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(MSBuildToolsPath)/Roslyn/bincore/Microsoft.CodeAnalysis.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(MSBuildToolsPath)/Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
